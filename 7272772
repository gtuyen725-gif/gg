for _, level in ipairs({"Low", "Mid", "High"}) do
    local btn = Instance.new("TextButton", btnContainer)
    btn.Name = level
    btn.Size = UDim2.new(1/3, -6, 1, 0)
    btn.Text = level
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false

    local isSel = (level == selected)
    btn.BackgroundColor3 = isSel and C.BtnSelectedBg or C.BtnUnselectedBg
    btn.TextColor3 = isSel and C.TextRed or C.BtnUnselectedText

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local str = Instance.new("UIStroke", btn)
    str.Color = isSel and C.BtnSelectedBorder or C.BtnUnselectedBorder
    str.Thickness = 2
    str.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    refs[level] = {Btn = btn, Stroke = str}

    btn.MouseButton1Click:Connect(function()
        selected = level
        for name, ref in pairs(refs) do
            local sel = (name == selected)
            ref.Btn.BackgroundColor3 = sel and C.BtnSelectedBg or C.BtnUnselectedBg
            ref.Btn.TextColor3 = sel and C.TextRed or C.BtnUnselectedText
            ref.Stroke.Color = sel and C.BtnSelectedBorder or C.BtnUnselectedBorder
        end
    end)

    btn.MouseEnter:Connect(function()
        if level ~= selected then btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35) end
    end)
    btn.MouseLeave:Connect(function()
        if level ~= selected then btn.BackgroundColor3 = C.BtnUnselectedBg end
    end)
end

--// ============================
--//  TOGGLE LOGIC
--// ============================
local function toggle()
    laggerActive = not laggerActive

    if laggerActive then
        -- Knob moves RIGHT, Status ON
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -22, 0.5, -10)
        }):Play()
        status.Text = "ON"
        status.TextColor3 = Color3.fromRGB(255, 60, 60)

        lagThread = task.spawn(function()
            while laggerActive do
                pcall(function()
                    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
                end)
                bomb(values[selected])
                task.wait(waitTime)
            end
        end)
    else
        -- Knob moves LEFT (back to OFF), Status OFF
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 2, 0.5, -10)
        }):Play()
        status.Text = "OFF"
        status.TextColor3 = C.TextRed

        if lagThread then task.cancel(lagThread) lagThread = nil end
    end
end

row.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggle()
    end
end)

--// ============================
--//  DRAGGING
--// ============================
local dragging, dragStart, startPos = false, nil, nil

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

main.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
